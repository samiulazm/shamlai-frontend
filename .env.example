# ============================================================================
# Shamlai E-commerce Platform - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control
# ============================================================================

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=shamlai.co
NODE_ENV=development


# ----------------------------------------------------------------------------
# Stripe Payment Gateway
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ----------------------------------------------------------------------------
# Email Service (Resend)
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Shamlai <noreply@yourdomain.com>

# ----------------------------------------------------------------------------
# SMS Service (BulkSMSBD) - Bangladesh SMS Provider
# ----------------------------------------------------------------------------
# Get your API key from: https://www.bulksmsbd.com/
BULKSMSBD_API_KEY=your_bulksmsbd_api_key
BULKSMSBD_SENDER_ID=your_approved_sender_id

# ----------------------------------------------------------------------------
# Pathao Courier Integration
# ----------------------------------------------------------------------------
PATHAO_API_URL=https://api-hermes.pathao.com/api/v1
PATHAO_CLIENT_ID=your_pathao_client_id
PATHAO_CLIENT_SECRET=your_pathao_client_secret
PATHAO_STORE_ID=your_pathao_store_id

# ----------------------------------------------------------------------------
# RedX Courier Integration
# ----------------------------------------------------------------------------
REDX_API_URL=https://openapi.redx.com.bd/v1.0.0-beta
REDX_API_KEY=your_redx_api_key

# ----------------------------------------------------------------------------
# Google Analytics (Optional)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ----------------------------------------------------------------------------
# Facebook Pixel (Optional)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_FB_PIXEL_ID=123456789012345

# ----------------------------------------------------------------------------
# Sentry Error Tracking (Optional)
# ----------------------------------------------------------------------------
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ----------------------------------------------------------------------------
# Cloudinary Image Upload (Optional)
# ----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ----------------------------------------------------------------------------
# OAuth Providers (Optional)
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ----------------------------------------------------------------------------
# Redis Cache (RECOMMENDED for production scaling to 1k-10k users)
# ----------------------------------------------------------------------------
# Redis is used for query result caching to improve performance
#
# Option 1: Upstash Redis (Recommended for Vercel/serverless)
# Sign up: https://upstash.com/ (Free tier: 10k commands/day)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Option 2: Standard Redis (for self-hosted/container deployments)
# Local development: redis://localhost:6379
# Production: Use managed Redis (e.g., Upstash, Redis Cloud, AWS ElastiCache)
REDIS_URL=redis://localhost:6379

# Optional: Redis password for production
# REDIS_URL=redis://:password@host:6379

# Performance Impact:
# - 10x faster API responses with caching
# - Scalable rate limiting across multiple instances
# - Reduced database load by 80%

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# Primary database - InsForge handles this automatically
NEXT_PUBLIC_INSFORGE_URL=https://your-project.insforge.app

# Optional: Read Replica for analytics (contact InsForge support to enable)
# NEXT_PUBLIC_INSFORGE_READ_REPLICA_URL=https://your-project-read.insforge.app

# Optional: Direct PostgreSQL access (if not using InsForge)
# DATABASE_URL=postgresql://user:password@host:5432/database

# ----------------------------------------------------------------------------
# Database Optimization
# ----------------------------------------------------------------------------
# Order archival age (in years) - default is 2
ORDER_ARCHIVAL_AGE_YEARS=2

# Cron secret for automated tasks (generate a random string)
# Used for securing cron endpoints like /api/cron/archive-orders
CRON_SECRET=your_random_cron_secret_min_32_characters_long

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PATHAO_INTEGRATION=true
ENABLE_REDX_INTEGRATION=true
ENABLE_STRIPE_PAYMENTS=true

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ----------------------------------------------------------------------------
# Session Configuration
# ----------------------------------------------------------------------------
SESSION_SECRET=your_random_session_secret_min_32_characters_long

# ----------------------------------------------------------------------------
# Development Tools
# ----------------------------------------------------------------------------
NEXT_TELEMETRY_DISABLED=1
