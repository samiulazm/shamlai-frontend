{
  "name": "shamlai-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "heroku-postbuild": "npm run build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:coverage": "jest --coverage",
    "test:redis": "tsx scripts/test-redis-connection.ts",
    "seed": "tsx scripts/seed-database.ts",
    "migrate": "tsx scripts/run-migrations.ts",
    "archive-orders": "tsx scripts/archive-old-orders.ts",
    "archive-orders:dry-run": "tsx scripts/archive-old-orders.ts --dry-run",
    "db:performance": "tsx scripts/database-performance.ts",
    "docker:build": "docker build -t shamlai-frontend .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "prepare": "husky install || true"
  },
  "dependencies": {
    "@sentry/nextjs": "^8.55.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.39.0",
    "@upstash/redis": "^1.35.6",
    "clsx": "2.1.1",
    "framer-motion": "11.3.31",
    "ioredis": "^5.8.2",
    "lucide-react": "0.468.0",
    "next": "^14.2.33",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7",
    "resend": "^4.0.1",
    "undici": "^7.16.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.11",
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "autoprefixer": "10.4.20",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.33",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "husky": "^8.0.3",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.0",
    "postcss": "8.4.47",
    "prettier": "^3.1.1",
    "tailwindcss": "3.4.13",
    "tsx": "^4.20.6",
    "typescript": "5.6.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "18.x || 20.x || 22.x",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "tmp": "^0.2.3"
  }
}
